// Configuration Cloudflare de VuPay.
// Seule chose à changer : "database_id" (voir le guide README.md, étape 3).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vupay",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Les pages de l'appli (public/). Le Worker ne s'occupe que de l'API et des vidéos.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/posters/*"]
  },

  // Base de données D1 : colle ici l'identifiant de ta base "vupay-db".
  "d1_databases": [
    { "binding": "DB", "database_name": "vupay-db", "database_id": "6475c916-ebcf-42a3-bb27-2c28d19e10ce" }
  ],

  // Stockage R2 des vidéos des annonceurs : crée un bucket nommé "vupay-media".
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "vupay-media" }
  ],

  // Réglages publics. Les secrets (ADMIN_TOKEN, clés API) se mettent dans le tableau de bord Cloudflare.
  "vars": {
    "DEV_SHOW_OTP": "1",
    "TIMEZONE": "Africa/Dakar",
    "MIN_WITHDRAW": "2000",
    "DAILY_GOAL": "5",
    "DAILY_BONUS": "300",
    "SEED_DEMO": "1",
    "MAX_UPLOAD_MB": "95",
    "MAX_VIDEO_SECONDS": "180",
    "SMS_PROVIDER": "console",
    "SMS_SENDER": "VuPay",
    "PAYOUT_PROVIDER": "simulation",
    "PUBLIC_URL": ""
  }
}
